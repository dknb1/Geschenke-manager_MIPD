# Gibt den oeffentlichen Teil frei; das Projektverzeichnis darueber ist gesperrt.
Require all granted
Options -Indexes

# Seiten nicht in fremde Seiten einbetten lassen und Dateitypen nicht raten.
<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
</IfModule>
